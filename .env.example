# Server-only Google settings. Copy into .env and restart Next.js.
GOOGLE_CLIENT_ID=your-client-id
# Configure this secret in the backend's .env for authorization-code exchange.
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback
GOOGLE_AUTH_BACKEND_URL=http://localhost:8000/api/auth/google/
# Server-side backend for password login and access-token verification.
# Keep Django running here; only frontend port 3000 needs forwarding for login.
DJANGO_API_URL=http://localhost:8000

# Legacy chat/admin API. If omitted, discover local port 5000 before using cPanel.
# BACKEND_API_URL=http://localhost:5000
# LOCAL_BACKEND_URL=http://localhost:5000
# Socket.IO upstream (must support HTTP polling through the frontend proxy).
# SOCKET_BACKEND_URL=http://localhost:5000
