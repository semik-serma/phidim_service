# ==========================================
# PHIDIM SERVICE - ENVIRONMENT CONFIGURATION
# ==========================================

# 1. cPanel Hosted Backend & Realtime API Endpoint
# Live cPanel Backend URL:
NEXT_PUBLIC_BACKEND_URL=https://service.phidimservice.com.np
NEXT_PUBLIC_SOCKET_URL=https://service.phidimservice.com.np

# 2. Localhost Backend URL (Used when local backend is running):
NEXT_PUBLIC_LOCAL_BACKEND_URL=http://localhost:5000

# 3. Google OAuth Credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CALLBACK_URL=https://service.phidimservice.com.np/api/auth/google/callback

# 4. NextAuth Configuration
NEXTAUTH_SECRET=your_random_nextauth_secret_32_chars_or_more
NEXTAUTH_URL=https://phidimservice.com.np
NEXT_PUBLIC_SITE_URL=https://phidimservice.com.np

# 5. RBAC / JWT Session Security
JWT_SECRET=generate_a_long_random_secret_here
REFRESH_TOKEN_SECRET=another_long_random_secret_here
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d

# 6. Database Connection (MongoDB)
MONGODB_URI=mongodb://127.0.0.1:27017/phidim_service
